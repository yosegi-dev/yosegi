{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"files": {
		"includes": [
			"**/*.{ts,tsx,js,jsx,json}",
			"!**/dist",
			"!**/.vitepress/cache",
			"!**/data",
			"!**/seeds",
			"!**/node_modules",
			"!**/yosegi-registry.json",
			"!**/.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": { "noForEach": "off" },
			"correctness": { "noUnusedImports": "error" },
			"suspicious": { "noArrayIndexKey": "off" },
			"a11y": { "useMediaCaption": "off" }
		}
	}
}
