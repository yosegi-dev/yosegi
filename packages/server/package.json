{
	"name": "@yosegi/yosegi",
	"description": "Yosegi CLI / MCP / HTTP adapters, including registry generation from host types and importing Stories back",
	"version": "0.3.0",
	"license": "MIT",
	"author": "dachi023",
	"homepage": "https://github.com/yosegi-dev/yosegi#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yosegi-dev/yosegi.git",
		"directory": "packages/server"
	},
	"bugs": {
		"url": "https://github.com/yosegi-dev/yosegi/issues"
	},
	"keywords": [
		"storybook",
		"csf",
		"design-system",
		"cli",
		"mcp",
		"agent-skill",
		"ai-agent"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"yosegi": "./bin/yosegi.js"
	},
	"files": [
		"bin",
		"dist",
		"skills",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "bun -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && bun run sync:skills",
		"sync:skills": "bun scripts/sync-skills.ts",
		"sync:skills:check": "bun scripts/sync-skills.ts --check",
		"prepack": "bun run build",
		"http": "bun run src/adapters/http/server.ts",
		"mcp": "bun run src/adapters/cli/main.ts mcp",
		"cli": "bun run src/adapters/cli/main.ts",
		"registry:build": "bun run src/adapters/cli/main.ts registry build",
		"typecheck": "bun --smol tsc --noEmit",
		"test": "bun --smol test",
		"lint": "bun --smol biome check ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@yosegi/core": "0.3.0",
		"hono": "^4.13.1",
		"react-docgen-typescript": "2.4.0",
		"typescript": ">=5.4.0 <7",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/react": "19.2.18"
	},
	"engines": {
		"node": ">=22"
	}
}
